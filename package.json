{
  "name": "nestjs-cookie-session",
  "version": "5.0.0",
  "description": "Idiomatic NestJS module for cookie session",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noemit && biome check src __tests__",
    "lint:fix": "tsc --noemit && biome check --write src __tests__",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamolegga/nestjs-cookie-session.git"
  },
  "keywords": [
    "nest",
    "nestjs",
    "nest.js",
    "session",
    "cookie",
    "cookie-session"
  ],
  "author": "iamolegga <iamolegga@gmail.com> (http://github.com/iamolegga)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iamolegga/nestjs-cookie-session/issues"
  },
  "homepage": "https://github.com/iamolegga/nestjs-cookie-session#readme",
  "dependencies": {
    "create-nestjs-middleware-module": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/cookie-session": "^2.0.49",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cookie-session": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@types/cookie-session": "^2.0.37",
    "cookie-session": "^2.0.0"
  }
}
